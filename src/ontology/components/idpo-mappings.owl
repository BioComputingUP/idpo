Prefix(:=<http://purl.obolibrary.org/obo/idpo/components/idpo-mappings.owl#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(sssom:=<https://w3id.org/sssom/>)
Prefix(semapv:=<http://w3id.org/semapv/vocab/>)


Ontology(<http://purl.obolibrary.org/obo/idpo/components/idpo-mappings.owl>
<http://purl.obolibrary.org/obo/idpo/releases/2026-11-03/components/idpo-mappings.owl>
Annotation(<http://purl.org/dc/terms/description> "Manually curated SKOS mappings from IDPO classes to related terms in other OBO ontologies, reviewed during the IDPO OBO Foundry review.")
Annotation(<http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI)
Annotation(<http://purl.org/dc/terms/title> "IDPO mappings to related terms in other ontologies")
Annotation(owl:versionInfo "2026-11-03")

Declaration(AnnotationProperty(<http://purl.org/dc/terms/created>))
Declaration(AnnotationProperty(<http://purl.org/dc/terms/description>))
Declaration(AnnotationProperty(<http://purl.org/dc/terms/license>))
Declaration(AnnotationProperty(<http://purl.org/dc/terms/title>))
Declaration(AnnotationProperty(<http://www.w3.org/2004/02/skos/core#broadMatch>))
Declaration(AnnotationProperty(<http://www.w3.org/2004/02/skos/core#closeMatch>))
Declaration(AnnotationProperty(<http://www.w3.org/2004/02/skos/core#narrowMatch>))
Declaration(AnnotationProperty(<http://www.w3.org/2004/02/skos/core#relatedMatch>))
Declaration(AnnotationProperty(sssom:mapping_justification))
Declaration(AnnotationProperty(sssom:object_label))
Declaration(AnnotationProperty(sssom:subject_label))
Declaration(Datatype(xsd:date))


AnnotationAssertion(Annotation(<http://purl.org/dc/terms/created> "2026-11-03"^^xsd:date) Annotation(rdfs:comment "Genuine specialization. PATO's bearer is unrestricted ('inhering in a bearer') while the IDPO quality inheres only in a protein region. The differentiae also differ: PATO says 'lacking distinct structure', whereas an IDR does have structure (transient secondary structure, defined conformational ensembles) and lacks specifically a stable fixed tertiary arrangement. Not equivalent, so not a reuse case.") Annotation(sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration>) Annotation(sssom:object_label "unstructured") Annotation(sssom:subject_label "disorder state") <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.obolibrary.org/obo/IDPO_0000002> <http://purl.obolibrary.org/obo/PATO_0001412>)
AnnotationAssertion(Annotation(<http://purl.org/dc/terms/created> "2026-11-03"^^xsd:date) Annotation(rdfs:comment "Overlapping but neither subsumes the other. SBO's genus is 'biochemical reaction' and its bearer is any reactant; IDPO's genus is BFO process and its bearer is a protein region moving between defined structural states. IDPO is broader on the process axis and narrower on the bearer axis, so closeMatch rather than broad/narrow.") Annotation(sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration>) Annotation(sssom:object_label "conformational transition") Annotation(sssom:subject_label "protein structural transition") <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/IDPO_0000010> <http://purl.obolibrary.org/obo/SBO_0000181>)
AnnotationAssertion(Annotation(<http://purl.org/dc/terms/created> "2026-11-03"^^xsd:date) Annotation(rdfs:comment "CHMO describes the general formation of a gel; IDPO's term is that process restricted to a liquid-like biomolecular condensate crosslinking into a gel-like state, i.e. a specialization.") Annotation(sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration>) Annotation(sssom:object_label "gelation") Annotation(sssom:subject_label "gelation") <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.obolibrary.org/obo/IDPO_0000027> <http://purl.obolibrary.org/obo/CHMO_0001646>)
AnnotationAssertion(Annotation(<http://purl.org/dc/terms/created> "2026-11-03"^^xsd:date) Annotation(rdfs:comment "Category difference confirmed by the definitions: MI:1126 denotes the intra-molecular interaction itself, while IDPO:0000056 is a BFO function borne by a protein region. The MI term names the process in which the IDPO function is realized, so the relation runs through 'realized in' rather than subsumption.") Annotation(sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration>) Annotation(sssom:object_label "self interaction") Annotation(sssom:subject_label "intramolecular interaction function") <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://purl.obolibrary.org/obo/IDPO_0000056> <http://purl.obolibrary.org/obo/MI_1126>)
AnnotationAssertion(Annotation(<http://purl.org/dc/terms/created> "2026-11-03"^^xsd:date) Annotation(rdfs:comment "Two differences. CHMO:0001305 is a process, IDPO:0000060 is a BFO function borne by a protein region. CHMO also describes association of separate components into higher-order structures (intermolecular), whereas the IDPO term covers association between regions of the same protein (intramolecular).") Annotation(sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration>) Annotation(sssom:object_label "self-assembly") Annotation(sssom:subject_label "intramolecular assembly function") <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://purl.obolibrary.org/obo/IDPO_0000060> <http://purl.obolibrary.org/obo/CHMO_0001305>)
AnnotationAssertion(Annotation(<http://purl.org/dc/terms/created> "2026-11-03"^^xsd:date) Annotation(rdfs:comment "TXPO:0002661 is generic ('the aggregation, arrangement and bonding together of molecules'), with no commitment to solubility, reversibility, or native state. IDPO:0000066 adds insoluble intermolecular interactions, irreversibility, a non-native protein state and an aberrant LLPS origin. A clear specialization.") Annotation(sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration>) Annotation(sssom:object_label "protein aggregation") Annotation(sssom:subject_label "protein aggregate formation") <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.obolibrary.org/obo/IDPO_0000066> <http://purl.obolibrary.org/obo/TXPO_0002661>)
AnnotationAssertion(Annotation(<http://purl.org/dc/terms/created> "2026-11-03"^^xsd:date) Annotation(rdfs:comment "GO's definition requires the product to be a non-membrane-bounded organelle, which confines it to a cellular context. IDPO:0000084 also covers in vitro condensate formation, which accounts for the majority of DisProt curation. GO's term is therefore the narrower of the two.") Annotation(sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration>) Annotation(sssom:object_label "membraneless organelle assembly") Annotation(sssom:subject_label "biomolecular condensate formation") <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://purl.obolibrary.org/obo/IDPO_0000084> <http://purl.obolibrary.org/obo/GO_0140694>)
AnnotationAssertion(Annotation(<http://purl.org/dc/terms/created> "2026-11-03"^^xsd:date) Annotation(rdfs:comment "Despite the label, ChEBI does not define this as a denatured state: it describes a protein lacking well-defined tertiary structure, flexible, non-compact, with little or no ordered secondary structure under physiological conditions, which is close to equivalent to the IDPO definition. IDPO retains its own term because the community label 'unfolded' conventionally denotes a denatured state of a protein that has a native fold, and because IDPO:0000096 carries a logical definition ('has quality' some 'disorder state') that ChEBI does not.") Annotation(sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration>) Annotation(sssom:object_label "unfolded protein") Annotation(sssom:subject_label "intrinsically disordered protein") <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/IDPO_0000096> <http://purl.obolibrary.org/obo/CHEBI_194424>)
AnnotationAssertion(Annotation(<http://purl.org/dc/terms/created> "2026-11-03"^^xsd:date) Annotation(rdfs:comment "MI:2274 is defined as an entity ('Entity whose activity exerts an effect...'), whereas IDPO:0000108 is a BFO function borne by such an entity. MI's term is also unrestricted as to target, while the IDPO function is specific to liquid-liquid phase separation and excludes bearers incorporated into the condensate.") Annotation(sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration>) Annotation(sssom:object_label "regulator") Annotation(sssom:subject_label "regulator function in condensate assembly") <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://purl.obolibrary.org/obo/IDPO_0000108> <http://purl.obolibrary.org/obo/MI_2274>)
)