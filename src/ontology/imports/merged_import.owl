AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0043039> "amino acid activation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0043039> "GO:0043039")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0043039> "tRNA aminoacylation")
